# =====================================================
# Email Lookup Tool — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git — it is in .gitignore
# =====================================================

# ---------------------------
# GitHub Personal Access Token (Recommended)
# Get one at: https://github.com/settings/tokens
# Scopes needed: none (public read only)
# Increases rate limit from 60 to 5,000 API req/hour
# ---------------------------
GITHUB_TOKEN=

# ---------------------------
# Residential Proxy Pool (Required for DuckDuckGo rotation & direct probes)
# ---------------------------
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_IPS=ip1:port,ip2:port,ip3:port

# ---------------------------
# Spotify Pathfinder GraphQL User Search (Auto-Refreshed via Headless Browser)
# RECOMMENDED: Provide SPOTIFY_SP_DC for 100% automated background token management.
# How to get your sp_dc cookie:
#   1. Open https://open.spotify.com in your browser and log in to your account.
#   2. Press F12 (Open DevTools) -> Application tab (or Storage tab in Firefox).
#   3. Click Cookies -> https://open.spotify.com
#   4. Find and copy the value of 'sp_dc' (and optionally 'sp_key').
#   5. Paste below. The backend will automatically solve the dynamic TOTP challenge
#      via Playwright in the background, refresh tokens 5 mins before expiry, and cache them.
# ---------------------------
SPOTIFY_SP_DC=
SPOTIFY_SP_KEY=

# Manual Fallback: Only needed if you don't use SPOTIFY_SP_DC above.
# (Bearer token copied from DevTools Network tab, expires every ~1 hour)
SPOTIFY_CLIENT_TOKEN=
SPOTIFY_AUTH_TOKEN=

# ---------------------------
# Stack Overflow / Stack Exchange API (Optional)
# Public API v2.3 works with 0 auth (300 requests/day per IP).
# Provide an optional registered app key to increase limits to 10,000 requests/day.
# Register an app at: https://stackapps.com/apps/oauth/register
# ---------------------------
STACKEXCHANGE_API_KEY=

# ---------------------------
# SMTP Handshake Sender Configuration (Port 25 Verification)
# Real sender address used in SMTP MAIL FROM / HELO during verification handshakes
# ---------------------------
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_HELO_HOST=mail.gmail.com

# ---------------------------
# Server Settings
# ---------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true
