# ==============================================================================
# Email Lookup Tool — Environment Configuration
# ==============================================================================
# Instructions:
#   1. Copy this file to .env:
#        Windows: copy example.env .env
#        Linux/macOS: cp example.env .env
#   2. Fill in the keys you wish to enable.
#   3. NEVER commit your real .env to git (it is included in .gitignore).
# ==============================================================================


# ==============================================================================
# 1. OPTIONAL — Works by Default (Keys increase rate limits)
# ==============================================================================

# GitHub Personal Access Token
# ------------------------------------------------------------------------------
# STATUS: Optional (Works by default with 0 auth)
# BEHAVIOR: 
#   - Without Token: Queries GitHub API with unauthenticated rate limits (60 req/hr).
#   - With Token: Increases rate limits to 5,000 req/hr for intensive lookups.
# GET KEY: https://github.com/settings/tokens (Scopes: none needed, public read only)
GITHUB_TOKEN=

# Stack Overflow / Stack Exchange API Key
# ------------------------------------------------------------------------------
# STATUS: Optional (Works by default with 0 auth)
# BEHAVIOR:
#   - Without Key: Stack Overflow user search works out-of-the-box (300 req/day per IP).
#   - With Key: Increases quota to 10,000 req/day.
# GET KEY: https://stackapps.com/apps/oauth/register (Register any app name)
STACKEXCHANGE_API_KEY=


# ==============================================================================
# 2. OPTIONAL — Skipped in Pipeline if Blank
# ==============================================================================

# Spotify Pathfinder GraphQL User Search (Automated Playwright Refresher)
# ------------------------------------------------------------------------------
# STATUS: Optional (Skipped in pipeline if left blank)
# BEHAVIOR:
#   - If Blank: The Spotify Pathfinder GraphQL search is skipped gracefully.
#   - If Set: Automatically solves Spotify dynamic TOTP via headless Playwright,
#     maintains fresh in-memory Bearer tokens (0ms lookup overhead), and returns
#     authenticated user candidates with verified display names and avatars.
# HOW TO GET YOUR sp_dc COOKIE:
#   1. Open https://open.spotify.com in your browser and log in.
#   2. Open DevTools (F12) -> Application tab (or Storage tab in Firefox).
#   3. Under Cookies -> https://open.spotify.com, copy the value of 'sp_dc' (and 'sp_key').
SPOTIFY_SP_DC=
SPOTIFY_SP_KEY=

# Spotify Manual Bearer Token (Alternative to SPOTIFY_SP_DC)
# ------------------------------------------------------------------------------
# STATUS: Optional (Skipped if SPOTIFY_SP_DC is set or if left blank)
# BEHAVIOR: Manual fallback Bearer token from DevTools Network tab (expires every ~1h).
SPOTIFY_CLIENT_TOKEN=
SPOTIFY_AUTH_TOKEN=


# ==============================================================================
# 3. OPTIONAL — Network Proxy Pool
# ==============================================================================

# Residential / Datacenter Proxy Pool
# ------------------------------------------------------------------------------
# STATUS: Optional
# BEHAVIOR:
#   - If Blank: All searches & direct probes execute directly from your host IP.
#   - If Set: Automatically rotates queries across proxy IPs with health ranking,
#     rate-limit cooldown tracking, and automatic multi-engine failover.
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_IPS=


# ==============================================================================
# 4. OPTIONAL — SMTP Verification Defaults
# ==============================================================================

# SMTP Handshake Sender Details (Port 25 Verification)
# ------------------------------------------------------------------------------
# STATUS: Optional (Has built-in fallback values)
# BEHAVIOR: Sender address used in SMTP MAIL FROM / HELO commands during verification.
SMTP_SENDER_EMAIL=verify@example.com
SMTP_HELO_HOST=mail.example.com


# ==============================================================================
# 5. SERVER SETTINGS
# ==============================================================================
HOST=127.0.0.1
PORT=8000
DEBUG=true
