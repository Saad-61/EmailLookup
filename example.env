# =====================================================
# Email Lookup Tool — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git — it is in .gitignore
# =====================================================

# ---------------------------
# GitHub Personal Access Token
# Get one at: https://github.com/settings/tokens
# Scopes needed: none (public read only)
# Gives you 5000 API req/hour instead of 60
# ---------------------------
GITHUB_TOKEN=

# ---------------------------
# Gravatar API Key (Optional but recommended)
# Get one at: https://gravatar.com/developers
# Increases rate limit from 100 to 1000 req/hour
# ---------------------------
GRAVATAR_API_KEY=

# ---------------------------
# AbstractAPI Email Verification (Fallback if port 25 is blocked)
# Get free key at: https://app.abstractapi.com/api/email-validation
# Free tier: 100 verifications/month
# ---------------------------
ABSTRACT_API_KEY=

# ---------------------------
# Have I Been Pwned API Key (Optional)
# Get key at: https://haveibeenpwned.com/API/Key
# Free tier available for non-commercial use
# ---------------------------
HIBP_API_KEY=

# ---------------------------
# SerpAPI (Optional — Google search fallback for LinkedIn)
# Get free key at: https://serpapi.com/
# Free tier: 100 searches/month
# Default fallback is DuckDuckGo HTML (no key needed)
# ---------------------------
SERPAPI_KEY=

# ---------------------------
# Server Settings
# ---------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true
