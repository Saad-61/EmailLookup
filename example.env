# =====================================================
# Email Lookup Tool — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git — it is in .gitignore
# =====================================================

# ---------------------------
# GitHub Personal Access Token (Recommended)
# Get one at: https://github.com/settings/tokens
# Scopes needed: none (public read only)
# Increases rate limit from 60 to 5,000 API req/hour
# ---------------------------
GITHUB_TOKEN=

# ---------------------------
# Residential Proxy Pool (Required for DuckDuckGo rotation & direct probes)
# ---------------------------
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_IPS=ip1:port,ip2:port,ip3:port

# ---------------------------
# Spotify Pathfinder GraphQL User Search (Optional)
# In open.spotify.com DevTools Network tab, copy 'client-token' and 'authorization' (Bearer token)
# ---------------------------
SPOTIFY_CLIENT_TOKEN=
SPOTIFY_AUTH_TOKEN=

# ---------------------------
# SMTP Handshake Sender Configuration (Port 25 Verification)
# Real sender address used in SMTP MAIL FROM / HELO during verification handshakes
# ---------------------------
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_HELO_HOST=mail.gmail.com

# ---------------------------
# External Search Providers (Optional Fallbacks)
# ---------------------------
# Google Custom Search API (100 free queries/day)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Serper.dev API (2,500 free Google searches)
SERPER_API_KEY=

# Serply.io API (Google search fallback)
SERPLY_API_KEY=

# ---------------------------
# Server Settings
# ---------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true
